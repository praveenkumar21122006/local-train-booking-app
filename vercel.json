{
  "version": 2,
  "buildCommand": "cd backend && npm install && npx prisma generate && npm run build && npx prisma db push --skip-generate --accept-data-loss || true && cd ..",
  "outputDirectory": "frontend",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/health",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "DATABASE_URL": "file:/tmp/dev.db",
    "JWT_SECRET": "vercel-jwt-secret-change-me-32chars",
    "JWT_REFRESH_SECRET": "vercel-refresh-secret-change-me",
    "QR_JWT_SECRET": "vercel-qr-secret-change-me-32chars"
  }
}
