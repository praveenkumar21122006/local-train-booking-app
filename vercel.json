{
  "buildCommand": "cd backend && npm install && npx prisma generate && npm run build",
  "outputDirectory": "frontend",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/dist/**, backend/node_modules/.prisma/**, backend/node_modules/@prisma/client/**, backend/prisma/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "DATABASE_URL": "file:/tmp/dev.db",
    "JWT_SECRET": "vercel-jwt-secret-change-me-32chars",
    "JWT_REFRESH_SECRET": "vercel-refresh-secret-change-me",
    "QR_JWT_SECRET": "vercel-qr-secret-change-me-32chars"
  }
}
